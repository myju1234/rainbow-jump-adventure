{
  "name": "rainbow-jump",
  "private": true,
  "version": "1.1.0",
  "main": "index.ts",
  "scripts": {
    "dev": "vite --host",
    "start": "npm run expo",
    "expo": "npm run build:expo && expo start --tunnel --go",
    "android": "npm run build:expo && expo start --android --go",
    "ios": "npm run build:expo && expo start --ios --go",
    "build": "tsc --noEmit && vite build",
    "build:expo": "vite build --config vite.expo.config.ts && node scripts/prepare-expo-html.mjs",
    "preview": "vite preview --host",
    "server": "uvicorn backend.main:app --reload --host 127.0.0.1 --port 8000",
    "cap:sync": "npm run build && npx cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "@capacitor/screen-orientation": "^6.0.3",
    "expo": "~57.0.15",
    "expo-screen-orientation": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-webview": "13.15.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.2.2",
    "@types/react-dom": "~19.2.2",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "~5.9.2",
    "vite": "^5.4.0",
    "vite-plugin-pwa": "^0.21.1",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
